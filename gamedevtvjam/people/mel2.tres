[sub_resource type="Resource" id="Resource_d2t1y"]
script = ExtResource("1_hnmf3")
from = "mel@idiotn.di"
to = "office@tinyglob.es"
subject = "another globe"
text = "Heey, my Friends loved the globe you made last time and asked if you could make another one? Maybe just get like a more green base or something similar because thats more Noras favourite. I wont have time to pick it up today, but would it be fine if I get it like tomorrow?
Best wishes,
Mel"
