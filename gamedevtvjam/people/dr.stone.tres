[sub_resource type="Resource" id="Resource_wybaj"]
script = ExtResource("1_fp571")
from = "dr.stone@offi.ce"
to = "office@tinyglob.es"
subject = "Globe for dr. stone"
text = "Greetings, 
someone in my dental practice recommended this shop to me and this made me want to come check out this store. I would like either like a building or something space themed with some kind of pink flair to it, maybe like a pink base. Just like my office floor.
Sincerly,
dr. Stone"
days_earlier = 0
metadata/_custom_type_script = "uid://brlife1n53d64"

[sub_resource type="Resource" id="Resource_8vrbu"]
script = ExtResource("1_fp571")
from = "dr.stone@offi.ce"
to = "office@tinyglob.es"
subject = "Office Order"
text = "Dear Shopkeeper,
one of my patients told me about your great shop and I got curious. Could it be possible to get me like a globe that fits into my office well? I think some bright colors could be great, and maybe some grass or moonstone in the globe would be great too.
Have a great day!
Dr. Stone"
days_earlier = 0
metadata/_custom_type_script = "uid://brlife1n53d64"

