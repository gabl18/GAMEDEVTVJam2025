[sub_resource type="Resource" id="Resource_qnost"]
script = ExtResource("1_nldtf")
from = "santa@real.com"
to = "office@tinyglob.es"
subject = "Elf outtage"
text = "Dear Snowglobestore owner,
thought I wouldnt ever write a E-Mail like this, but my elves stopped working and are protesting because of the work conditions here... I would really need some help from you. Could you prepare me one of your globes? I will personally come pick it up as soon as possible. I hope you can make some kid happy. 
Thanks in advance,
Santa"
days_earlier = 0
metadata/_custom_type_script = "uid://brlife1n53d64"

