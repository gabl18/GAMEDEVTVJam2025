[sub_resource type="Resource" id="Resource_4lmeg"]
script = ExtResource("1_mko5t")
from = "schnitzelfactory@next.door"
to = "office@tinyglob.es"
subject = "schnitzel-tastic order"
text = "Hallo, ich wünsche Ihnen einen schnitzel-tastischen Tag!
Wir kontaktieren Sie aus der Schnitzelfabrik neben Ihrem Geschäft und möchten eine Schneekugel bestellen. Bitte verwenden sie auch die graue oder grüne Basis. Wir würden uns sehr freuen, wenn die Schneekugel ähnlich zu der anderen wäre.
Wir schicken morgen einen Mitarbeiter, um die Kugel abzuholen.
Haben Sie noch einen wunderschönen Tag!"
days_earlier = -1
metadata/_custom_type_script = "uid://brlife1n53d64"

