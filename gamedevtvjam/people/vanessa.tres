[sub_resource type="Resource" id="Resource_4lmeg"]
script = ExtResource("1_l1ma3")
from = "frank_wood@inlook.com"
to = "office@tinyglob.es"
subject = "Gift for my F-Friend"
text = "Uhm, hello... This is kinda akward - but I would want to order one of your uhm, globes for my girlf- uhm just friend I mean, I uuh think she really likes Paris, so maybe you have something like France themed or sth like that. Uhm, I am also almost certain that she would like a wodden base for the globe. T- thanks for doing that. I will meet her like tomorrow, so she can come pick it up the day after that. Maybe she will lo- uhm like me more with that gift.
Greetings,
Frank"
days_earlier = -2
metadata/_custom_type_script = "uid://brlife1n53d64"

